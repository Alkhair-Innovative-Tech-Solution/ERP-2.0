# Content Service Environment Variables
# Copy this file to .env and fill in the actual values

# ===== REQUIRED =====

# Database Configuration
DATABASE_URL=postgresql://lms_user:lms_password@postgres-main:5432/content_db
DB_HOST=postgres-main
DB_NAME=content_db

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8001

# Redis
REDIS_URL=redis://redis:6379/5

# Auth
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# ===== OPTIONAL (with defaults) =====

# Service API Key - For service-to-service authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=CHANGE_ME_TO_RANDOM_API_KEY

# Debug (NEVER enable in production!)
DEBUG=True

# Python Path
PYTHONPATH=/app:/app/shared

# Django Security
SECRET_KEY=django-insecure-dev-only-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001