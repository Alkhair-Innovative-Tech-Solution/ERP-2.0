# Auth Service Environment Variables
# Copy this file to .env and fill in the actual values

# ===== REQUIRED =====

# JWT Secret Key - Used for signing JWT tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY

# Service API Key - For service-to-service authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=CHANGE_ME_TO_RANDOM_API_KEY

# Database Configuration
POSTGRES_DB=lms_auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres-auth
POSTGRES_PORT=5432

# ===== OPTIONAL (with defaults) =====

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME=30  # minutes (default: 30)
JWT_REFRESH_TOKEN_LIFETIME=7  # days (default: 7)

# Email Configuration (for password reset, email verification)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Debug (NEVER enable in production!)
DEBUG=False
