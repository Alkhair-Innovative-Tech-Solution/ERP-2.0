# Copy to .env and fill in real values for your environment. Never commit
# real secrets — this file only documents what exists and shows the shape.

# Shared secret for X-Internal-Secret-gated calls between SMS services and
# central auth (Enterprise-Resource-Planning/Auth-service-main) — must match
# the SMS_INTERNAL_SECRET set on central auth's own .env. Phase B4.
SMS_INTERNAL_SECRET=change-me-to-a-real-shared-secret

# Read-only creds for central auth's Postgres, used only by the offline
# remap_central_user_ids management command (staff-service, student-service).
# Phase C8.
CENTRAL_AUTH_DB_PASSWORD=change-me

# Phase D-b3: the on-switch for staff+student dual-write to central auth's
# SMS01 tenant. Defaults to `false` in docker-compose.yml when unset —
# leave this commented out unless you've confirmed central auth is
# reachable at CENTRAL_AUTH_URL from your SMS containers (see
# docs/PHASE_D_B3_SYNC_ON_RESULT.md for how to check, and the extra_hosts
# note if you're not on Docker Desktop).
# SYNC_TO_CENTRAL_AUTH=true

# Only needed if central auth isn't reachable at the docker-compose.yml
# default (http://host.docker.internal:8000) in your setup.
# CENTRAL_AUTH_URL=http://host.docker.internal:8000

# Phase D-b4: frontend dual-run login switch. 'legacy' (default) keeps the
# SMS login page posting to auth-8001 exactly as before — nothing changes
# until this is deliberately set. Build-time only (baked into the frontend
# image by `next build`/docker-compose's frontend build args) — changing
# this requires rebuilding the frontend image, not just restarting it. See
# docs/PHASE_D_B4_FRONTEND_ADAPTER_RESULT.md.
# NEXT_PUBLIC_AUTH_SOURCE=central
# NEXT_PUBLIC_CENTRAL_AUTH_URL=http://localhost:8000
