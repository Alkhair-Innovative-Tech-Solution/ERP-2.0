# ERP Shared Infrastructure Configuration — TEMPLATE
# Copy to .env (production) or .env.dev (local dev) and fill in values.
# NEVER commit .env or .env.dev — they contain secrets.
# ==========================================

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=auth_db,hdms_db,sms_iak_db

# Database URLs — use pgbouncer for prod, direct postgres for dev
DATABASE_URL=postgresql://erp_admin:change_me@erp_pgbouncer:6432/hdms_db
AUTH_DATABASE_URL=postgresql://erp_admin:change_me@erp_pgbouncer:6432/auth_db
SIS_DATABASE_URL=postgresql://erp_admin:change_me@erp_pgbouncer:6432/sms_iak_db

# Legacy DB settings
DB_USER=erp_admin
DB_PASSWORD=change_me
DB_HOST=erp_pgbouncer
DB_PORT=6432
AUTH_DB_NAME=auth_db
SIS_DB_NAME=sms_iak_db
HDMS_DB_NAME=hdms_db

# ------------------------------------------
# Redis
# ------------------------------------------
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@erp_redis:6379/1
SIS_REDIS_URL=redis://:change_me@erp_redis:6379/1
AUTH_REDIS_URL=redis://:change_me@erp_redis:6379/0

# ------------------------------------------
# Django
# ------------------------------------------
DEBUG=False
SECRET_KEY=change_me_to_a_long_random_string
ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False
MEDIA_ROOT=/app/media
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1440

# ------------------------------------------
# Network
# ------------------------------------------
ERP_NETWORK=erp_network

# ------------------------------------------
# Internal Service URLs
# ------------------------------------------
AUTH_SERVICE_URL=http://auth_service:8000
USER_SERVICE_URL=http://user-service:8001
TICKET_SERVICE_URL=http://ticket-service:8002
COMMUNICATION_SERVICE_URL=http://communication-service:8003
FILE_SERVICE_URL=http://file-service:8005
SIS_BACKEND_URL=http://sis-backend:8010

# Frontend public URLs (set to domain in prod, localhost in dev)
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://hdms.yourdomain.com
NEXT_PUBLIC_AUTH_SERVICE_URL=https://hrms.yourdomain.com
NEXT_PUBLIC_TICKET_SERVICE_URL=https://hdms.yourdomain.com
NEXT_PUBLIC_COMMUNICATION_SERVICE_URL=https://hdms.yourdomain.com
NEXT_PUBLIC_FILE_SERVICE_URL=https://hdms.yourdomain.com
HDMS_FRONTEND_URL=https://hdms.yourdomain.com

# ------------------------------------------
# Email (SMTP)
# ------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=change_me

# ------------------------------------------
# JWT RS256 Keys
# ------------------------------------------
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/etc/erp/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/etc/erp/keys/jwt_public.pem
