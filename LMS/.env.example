# AIT-LMS Root Environment Variables
# Copy this file to .env and fill in the actual values
# This file is used by docker-compose.yml for all services

# ===== REQUIRED =====

# JWT Secret Key - Used for signing JWT tokens across all services
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY

# Service API Key - For service-to-service authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=CHANGE_ME_TO_RANDOM_API_KEY

# Database Credentials (default for development)
DB_USER=lms_user
DB_PASSWORD=lms_password

# ===== OPTIONAL (with defaults) =====

# Django Secret Key
SECRET_KEY=django-insecure-dev-only-change-in-production

# Debug (NEVER enable in production!)
DEBUG=True

# Email Configuration (Gmail SMTP)
# Gmail: Enable 2-Step Verification → App Passwords → "Mail" → 16-digit password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@yourdomain.com
EMAIL_HOST_PASSWORD=your-app-password

# API Gateway (optional override)
# API_GATEWAY_VOLUME=./lms-microservices/api-gateway

# Frontend API URL (production override)
# NEXT_PUBLIC_API_URL=https://your-api-domain.com

# LMS Frontend Dockerfile (dev/prod)
# LMS_FRONTEND_DOCKERFILE=Dockerfile

# Node Environment
NODE_ENV=development